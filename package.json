
{
  "name": "lucas-os",
  "version": "4.0.0",
  "description": "LUCAS OS Gaming Platform",
  "author": "Lucas",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "build": {
    "appId": "com.lucasos.desktop",
    "productName": "LUCAS OS",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "DITT-GITHUB-NAMN",
      "repo": "LUCAS-OS"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "createDesktopShortcut": true
    }
  }
}
